+// the scene's own light scale, so ordinary bright GI is left untouched.
+static const float kFireflyLightScale = 16.0f;
+
+float3 ClampFirefly(float3 sampleRadiance)
+{
+    const float sunLuminance = Color::RGBToLuminance(float3(Raytracing.DirectionalLight.Color)) * Raytracing.Directional;
