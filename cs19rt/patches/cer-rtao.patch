+
+		eastl::vector<ShaderDefine> m_Defines;
+
+		void ResetBindings() { m_BindingSets.fill(nullptr); }
+		eastl::vector<ShaderDefine> BuildDefines(const Settings& settings) const;
+
+	public:
+		DirectLights(Renderer* renderer, SceneTLAS* sceneTLAS, AmbientOcclusion* ambientOcclusion);
