diff --git a/src/Pass/Raytracing/AmbientOcclusion.cpp b/src/Pass/Raytracing/AmbientOcclusion.cpp
new file mode 100644
index 0000000..04ae9a8
--- /dev/null
+++ b/src/Pass/Raytracing/AmbientOcclusion.cpp
@@ -0,0 +1,307 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// FalkosLichtspiel: raytraced ambient occlusion for the raster lighting modes.
+// Pass 1 traces short alpha-tested visibility rays from the raster G-buffer and
+// accumulates them over time (own history, engine motion vectors). Pass 2 applies
+// an edge-aware spatial filter and writes AO to the shared main texture, which the
+// host multiplies into the raster ambient term in its deferred composite.
+#include "AmbientOcclusion.h"
+#include "Renderer.h"
+#include "Scene.h"
+#include "ShaderCache.h"
+#include "ShaderUtils.h"
+#include "Types/InstanceMask.h"
+
+namespace Pass::Raytracing
+{
+	AmbientOcclusion::AmbientOcclusion(Renderer* renderer, SceneTLAS* sceneTLAS)
+		: RenderPass(renderer), m_SceneTLAS(sceneTLAS)
+	{
+		auto device = renderer->GetDevice();
+
+		m_LinearWrapSampler = device->createSampler(
+			nvrhi::SamplerDesc()
+			.setAllAddressModes(nvrhi::SamplerAddressMode::Wrap)
+			.setAllFilters(true));
+
+		m_LinearClampSampler = device->createSampler(
+			nvrhi::SamplerDesc()
+			.setAllAddressModes(nvrhi::SamplerAddressMode::Clamp)
+			.setAllFilters(true));
+
+		m_PointWrapSampler = device->createSampler(
+			nvrhi::SamplerDesc()
+			.setAllAddressModes(nvrhi::SamplerAddressMode::Wrap)
+			.setAllFilters(false));
+
+		m_Supported = device->queryFeatureSupport(nvrhi::Feature::RayQuery);
+		if (!m_Supported)
+			logger::error("FalkosLichtspiel RT AO: inline ray queries (DXR 1.1) are not supported, RT AO stays off");
+
+		m_Defines = BuildDefines(Scene::GetSingleton()->m_Settings);
+
+		m_SceneTLAS->GetTopLevelAS().AddListener(this);
+	}
+
+	eastl::vector<ShaderDefine> AmbientOcclusion::BuildDefines(const Settings& settings) const
+	{
+		auto defines = Util::Shader::GetRaytracingDefines(settings, false, false);
+		defines.emplace_back(L"THREAD_GROUP_SIZE", Constants::GI_DISPATCH_THREADS);
+		// No water in AO (same as GI)
+		auto instanceMask = InstanceMask::All & ~InstanceMask::Water;
+		defines.emplace_back(L"INSTANCE_MASK", instanceMask);
+		return defines;
+	}
+
+	void AmbientOcclusion::ResetBindings()
+	{
+		for (auto& sets : m_TraceSets)
+			sets.fill(nullptr);
+		for (auto& sets : m_FilterSets)
+			sets.fill(nullptr);
+	}
+
+	void AmbientOcclusion::ResolutionChanged([[maybe_unused]] uint2 resolution)
+	{
+		ResetBindings();
+	}
+
+	void AmbientOcclusion::SettingsChanged(const Settings& settings)
+	{
+		auto defines = BuildDefines(settings);
+		if (defines != m_Defines) {
+			m_Defines = eastl::move(defines);
+			CreatePipeline();
+		}
+	}
+
+	void AmbientOcclusion::EnsureHistory()
+	{
+		const uint2 resolution = GetRenderer()->GetResolution();
+		if (m_History[0] && m_History[1] && resolution.x == m_HistorySize.x && resolution.y == m_HistorySize.y)
+			return;
+
+		auto device = GetRenderer()->GetDevice();
+
+		for (uint32_t i = 0; i < 2; i++) {
+			nvrhi::TextureDesc desc;
+			desc.width = eastl::max<uint32_t>(1u, resolution.x);
+			desc.height = eastl::max<uint32_t>(1u, resolution.y);
+			desc.format = nvrhi::Format::RGBA16_FLOAT;
+			desc.isUAV = true;
+			desc.initialState = nvrhi::ResourceStates::Common;
+			desc.keepInitialState = true;
+			const std::string name = std::format("RT AO History {}", i);
+			desc.debugName = name.c_str();
+			m_History[i] = device->createTexture(desc);
+		}
+
+		m_HistorySize = resolution;
+		m_Parity = 0;
+		ResetBindings();
+	}
+
+	void AmbientOcclusion::CreatePipeline()
+	{
+		ResetBindings();
+		m_TracePipeline = nullptr;
+		m_FilterPipeline = nullptr;
+
+		if (!m_Supported)
+			return;
+
+		auto device = GetRenderer()->GetDevice();
+		auto* sceneGraph = Scene::GetSingleton()->GetSceneGraph();
+
+		// Trace + temporal pass: same resource set as the GI ray generation (its
+		// Registers.hlsli), plus the history input and the engine motion vectors.
+		{
+			nvrhi::BindingLayoutDesc layoutDesc;
+			layoutDesc.visibility = nvrhi::ShaderType::Compute;
+			layoutDesc.bindings = {
+				nvrhi::BindingLayoutItem::Sampler(0),
+				nvrhi::BindingLayoutItem::Sampler(1),
+				nvrhi::BindingLayoutItem::Sampler(2),
+				nvrhi::BindingLayoutItem::VolatileConstantBuffer(0),
+				nvrhi::BindingLayoutItem::VolatileConstantBuffer(1),
+				nvrhi::BindingLayoutItem::VolatileConstantBuffer(2),
+				nvrhi::BindingLayoutItem::RayTracingAccelStruct(0),
+				nvrhi::BindingLayoutItem::Texture_SRV(1),
+				nvrhi::BindingLayoutItem::Texture_SRV(2),
+				nvrhi::BindingLayoutItem::StructuredBuffer_SRV(3),
+				nvrhi::BindingLayoutItem::StructuredBuffer_SRV(4),
+				nvrhi::BindingLayoutItem::StructuredBuffer_SRV(5),
+				nvrhi::BindingLayoutItem::Texture_SRV(6),
+				nvrhi::BindingLayoutItem::Texture_SRV(7),
+				nvrhi::BindingLayoutItem::Texture_SRV(8),
+				nvrhi::BindingLayoutItem::Texture_SRV(9),
+				nvrhi::BindingLayoutItem::Texture_SRV(10),
+				nvrhi::BindingLayoutItem::Texture_SRV(13),
+				nvrhi::BindingLayoutItem::Texture_SRV(14),
+				nvrhi::BindingLayoutItem::Texture_SRV(15),
+				nvrhi::BindingLayoutItem::StructuredBuffer_SRV(16),
+				nvrhi::BindingLayoutItem::RawBuffer_SRV(19),
+				nvrhi::BindingLayoutItem::RawBuffer_SRV(20),
+				nvrhi::BindingLayoutItem::Texture_SRV(21),  // AO history (previous)
+				nvrhi::BindingLayoutItem::Texture_SRV(22),  // engine motion vectors
+				nvrhi::BindingLayoutItem::Texture_UAV(0)    // AO history (current)
+			};
+			m_TraceLayout = device->createBindingLayout(layoutDesc);
+
+			auto defines = Util::Shader::GetDXCDefines(m_Defines);
+			defines.emplace_back(L"USE_RAY_QUERY", L"1");
+
+			auto blob = ShaderCache::GetShader(L"data/shaders/raytracing/AmbientOcclusion/RayGeneration.hlsl", defines, ShaderStage::Compute);
+			if (!blob) {
+				logger::error("FalkosLichtspiel RT AO: trace shader compilation failed");
+				return;
+			}
+			m_TraceShader = device->createShader({ nvrhi::ShaderType::Compute, "RT AO Trace", "Main" }, blob->GetBufferPointer(), blob->GetBufferSize());
+			if (!m_TraceShader)
+				return;
+
+			auto pipelineDesc = nvrhi::ComputePipelineDesc()
+				.setComputeShader(m_TraceShader)
+				.addBindingLayout(m_TraceLayout)
+				.addBindingLayout(sceneGraph->GetTriangleDescriptors()->m_Layout)
+				.addBindingLayout(sceneGraph->GetVertexDescriptors()->m_Layout)
+				.addBindingLayout(sceneGraph->GetMaterialDescriptors()->m_Layout)
+				.addBindingLayout(sceneGraph->GetTextureDescriptors()->m_Layout)
+				.addBindingLayout(sceneGraph->GetCubemapDescriptors()->m_Layout)
+				.addBindingLayout(sceneGraph->GetDynamicVertexDescriptors()->m_Layout);
+
+			m_TracePipeline = device->createComputePipeline(pipelineDesc);
+		}
+
+		// Spatial filter pass.
+		{
+			nvrhi::BindingLayoutDesc layoutDesc;
+			layoutDesc.visibility = nvrhi::ShaderType::Compute;
+			layoutDesc.bindings = {
+				nvrhi::BindingLayoutItem::VolatileConstantBuffer(0),
+				nvrhi::BindingLayoutItem::Texture_SRV(0),
+				nvrhi::BindingLayoutItem::Texture_SRV(1),
+				nvrhi::BindingLayoutItem::Texture_UAV(0)
+			};
+			m_FilterLayout = device->createBindingLayout(layoutDesc);
+
+			winrt::com_ptr<IDxcBlob> blob;
+			ShaderUtils::CompileShader(blob, L"data/shaders/AOFilter.hlsl", {}, ShaderStage::Compute, L"Main");
+			if (!blob) {
+				logger::error("FalkosLichtspiel RT AO: filter shader compilation failed");
+				return;
+			}
+			m_FilterShader = device->createShader({ nvrhi::ShaderType::Compute, "RT AO Filter", "Main" }, blob->GetBufferPointer(), blob->GetBufferSize());
+			if (!m_FilterShader)
+				return;
+
+			m_FilterPipeline = device->createComputePipeline(
+				nvrhi::ComputePipelineDesc().setComputeShader(m_FilterShader).addBindingLayout(m_FilterLayout));
+		}
+
+		logger::info("FalkosLichtspiel RT AO: pipelines {}", (m_TracePipeline && m_FilterPipeline) ? "created" : "FAILED");
+	}
+
+	void AmbientOcclusion::Execute(nvrhi::ICommandList* commandList)
+	{
+		auto* renderer = GetRenderer();
+		auto* mainTexture = renderer->GetMainTexture();
+
+		if (!m_TracePipeline || !m_FilterPipeline) {
+			// Without a working pipeline report "fully open" so the raster image is unchanged.
+			commandList->clearTextureFloat(mainTexture, nvrhi::AllSubresources, nvrhi::Color(1.f));
+			return;
+		}
+
+		EnsureHistory();
+
+		const uint32_t slot = renderer->GetCurrentSlot();
+		const uint32_t current = m_Parity;
+		const uint32_t previous = 1u - m_Parity;
+
+		auto* scene = Scene::GetSingleton();
+		auto* sceneGraph = scene->GetSceneGraph();
+		auto* renderTargets = renderer->GetRenderTargets();
+		auto& textureManager = renderer->RenderTargetManager();
+
+		auto& traceSet = m_TraceSets[slot][current];
+		if (!traceSet) {
+			nvrhi::BindingSetDesc desc;
+			desc.bindings = {
+				nvrhi::BindingSetItem::Sampler(0, m_LinearWrapSampler),
+				nvrhi::BindingSetItem::Sampler(1, m_LinearClampSampler),
+				nvrhi::BindingSetItem::Sampler(2, m_PointWrapSampler),
+				nvrhi::BindingSetItem::ConstantBuffer(0, scene->GetCameraBuffer()),
+				nvrhi::BindingSetItem::ConstantBuffer(1, m_SceneTLAS->GetRaytracingBuffer()),
+				nvrhi::BindingSetItem::ConstantBuffer(2, scene->GetFeatureBuffer()),
+				nvrhi::BindingSetItem::RayTracingAccelStruct(0, m_SceneTLAS->GetTopLevelAS().GetHandle()),
+				nvrhi::BindingSetItem::Texture_SRV(1, scene->GetSkyHemiTexture()),
+				nvrhi::BindingSetItem::Texture_SRV(2, scene->GetFlowMapTexture()),
+				nvrhi::BindingSetItem::StructuredBuffer_SRV(3, sceneGraph->GetLightBuffer()),
+				nvrhi::BindingSetItem::StructuredBuffer_SRV(4, sceneGraph->GetInstanceBuffer()),
+				nvrhi::BindingSetItem::StructuredBuffer_SRV(5, sceneGraph->GetMeshBuffer()),
+				nvrhi::BindingSetItem::Texture_SRV(6, renderer->GetDepthTexture()),
+				nvrhi::BindingSetItem::Texture_SRV(7, renderTargets->albedo),
+				nvrhi::BindingSetItem::Texture_SRV(8, renderTargets->normalRoughness),
+				nvrhi::BindingSetItem::Texture_SRV(9, renderTargets->gnmao),
+				nvrhi::BindingSetItem::Texture_SRV(10, textureManager.GetTexture(RenderTarget::FaceNormals)),
+				nvrhi::BindingSetItem::Texture_SRV(13, renderer->GetWaterDisplacementTexture()),
+				nvrhi::BindingSetItem::Texture_SRV(14, scene->GetSkinDetailNormalTexture()),
+				nvrhi::BindingSetItem::Texture_SRV(15, scene->GetProjNoiseTexture()),
+				nvrhi::BindingSetItem::StructuredBuffer_SRV(16, sceneGraph->GetTransformBuffer()),
+				nvrhi::BindingSetItem::RawBuffer_SRV(19, sceneGraph->GetMeshSlotRemapBuffer()),
+				nvrhi::BindingSetItem::RawBuffer_SRV(20, sceneGraph->GetPropertiesBuffer()),
+				nvrhi::BindingSetItem::Texture_SRV(21, m_History[previous]),
+				nvrhi::BindingSetItem::Texture_SRV(22, renderer->GetMotionVectorTexture()),
+				nvrhi::BindingSetItem::Texture_UAV(0, m_History[current])
+			};
+			traceSet = renderer->GetDevice()->createBindingSet(desc, m_TraceLayout);
+		}
+
+		auto& filterSet = m_FilterSets[slot][current];
+		if (!filterSet) {
+			nvrhi::BindingSetDesc desc;
+			desc.bindings = {
+				nvrhi::BindingSetItem::ConstantBuffer(0, scene->GetCameraBuffer()),
+				nvrhi::BindingSetItem::Texture_SRV(0, m_History[current]),
+				nvrhi::BindingSetItem::Texture_SRV(1, renderTargets->normalRoughness),
+				nvrhi::BindingSetItem::Texture_UAV(0, mainTexture)
+			};
+			filterSet = renderer->GetDevice()->createBindingSet(desc, m_FilterLayout);
+		}
+
+		if (!traceSet || !filterSet) {
+			commandList->clearTextureFloat(mainTexture, nvrhi::AllSubresources, nvrhi::Color(1.f));
+			return;
+		}
+
+		const auto resolution = renderer->GetDynamicResolution();
+		const auto groups = Util::Math::GetDispatchCount(resolution, 8);
+
+		commandList->beginMarker("FalkosLichtspiel RT AO");
+		{
+			nvrhi::ComputeState state;
+			state.pipeline = m_TracePipeline;
+			state.bindings = {
+				traceSet,
+				sceneGraph->GetTriangleDescriptors()->m_DescriptorTable->GetDescriptorTable(),
+				sceneGraph->GetVertexDescriptors()->m_DescriptorTable->GetDescriptorTable(),
+				sceneGraph->GetMaterialDescriptors()->m_DescriptorTable,
+				sceneGraph->GetTextureDescriptors()->m_DescriptorTable->GetDescriptorTable(),
+				sceneGraph->GetCubemapDescriptors()->m_DescriptorTable->GetDescriptorTable(),
+				sceneGraph->GetDynamicVertexDescriptors()->m_DescriptorTable
+			};
+			commandList->setComputeState(state);
+			commandList->dispatch(groups.x, groups.y);
+		}
+		{
+			nvrhi::ComputeState state;
+			state.pipeline = m_FilterPipeline;
+			state.bindings = { filterSet };
+			commandList->setComputeState(state);
+			commandList->dispatch(groups.x, groups.y);
+		}
+		commandList->endMarker();
+
+		m_Parity = previous;
+	}
+}
