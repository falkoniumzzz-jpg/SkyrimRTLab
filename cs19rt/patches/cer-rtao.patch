diff --git a/shaders/AOFilter.hlsl b/shaders/AOFilter.hlsl
new file mode 100644
index 0000000..41c52ea
--- /dev/null
+++ b/shaders/AOFilter.hlsl
@@ -0,0 +1,72 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// FalkosLichtspiel: edge-aware spatial filter for the raytraced AO history.
+// Writes the final AO (1 = open) to the shared main texture for the raster composite.
+
+#include "interop/CameraData.hlsli"
+
+ConstantBuffer<CameraData> Camera       : register(b0);
+
+Texture2D<float4> AOHistory             : register(t0); // x = AO, y = view depth, z = history length
+Texture2D<snorm float4> NormalRoughness : register(t1);
+
+RWTexture2D<float4> Output              : register(u0);
+
+static const float kFadeStart = 5000.0f; // view depth where AO starts fading out
+static const float kFadeEnd   = 8000.0f; // beyond this the BVH lacks LOD detail
+
+[numthreads(8, 8, 1)]
+void Main(uint2 idx : SV_DispatchThreadID)
+{
+    const uint2 size = Camera.RenderSize;
+    if (any(idx >= size))
+        return;
+
+    const float4 center = AOHistory.Load(int3(idx, 0));
+    const float depth0 = center.y;
+
+    if (depth0 <= 0.0f) {
+        Output[idx] = float4(1.0f, 1.0f, 1.0f, 1.0f);
+        return;
+    }
+
+    float3 n0 = NormalRoughness.Load(int3(idx, 0)).xyz;
+    n0 = dot(n0, n0) > 1e-6f ? normalize(n0) : float3(0.0f, 0.0f, 1.0f);
+
+    // Young history (disocclusion) gets a wider footprint.
+    const int stride = center.z < 4.0f ? 2 : 1;
+    const float depthSigma = max(0.02f * depth0, 1e-3f);
+
+    float sum = 0.0f;
+    float weightSum = 0.0f;
+
+    [unroll]
+    for (int y = -2; y <= 2; y++)
+    {
+        [unroll]
+        for (int x = -2; x <= 2; x++)
+        {
+            const int2 p = clamp(int2(idx) + int2(x, y) * stride, int2(0, 0), int2(size) - 1);
+            const float4 s = AOHistory.Load(int3(p, 0));
+            if (s.y <= 0.0f)
+                continue;
+
+            float3 n = NormalRoughness.Load(int3(p, 0)).xyz;
+            n = dot(n, n) > 1e-6f ? normalize(n) : n0;
+
+            const float wSpatial = exp(-0.25f * float(x * x + y * y));
+            const float wDepth = exp(-abs(s.y - depth0) / depthSigma);
+            const float wNormal = pow(saturate(dot(n, n0)), 8.0f);
+            const float w = wSpatial * wDepth * wNormal;
+
+            sum += s.x * w;
+            weightSum += w;
+        }
+    }
+
+    float ao = weightSum > 1e-4f ? sum / weightSum : center.x;
+
+    const float fade = saturate((depth0 - kFadeStart) / (kFadeEnd - kFadeStart));
+    ao = lerp(saturate(ao), 1.0f, fade);
+
+    Output[idx] = float4(ao, ao, ao, 1.0f);
+}
diff --git a/shaders/raytracing/AmbientOcclusion/RayGeneration.hlsl b/shaders/raytracing/AmbientOcclusion/RayGeneration.hlsl
new file mode 100644
index 0000000..f4a29cf
--- /dev/null
+++ b/shaders/raytracing/AmbientOcclusion/RayGeneration.hlsl
@@ -0,0 +1,140 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// FalkosLichtspiel: raytraced ambient occlusion for the raster lighting path.
+// Traces a few short cosine-weighted visibility rays from the raster G-buffer
+// (alpha-tested like the GI shadow rays) and accumulates them over time.
+// Output (history): x = AO (1 = open), y = view depth, z = history length, w = 1.
+
+#include "raytracing/GlobalIllumination/Registers.hlsli"
+
+#include "include/Common.hlsli"
+#include "raytracing/include/Common.hlsli"
+#include "raytracing/include/Payload.hlsli"
+#include "raytracing/include/Geometry.hlsli"
+#include "raytracing/include/Transparency.hlsli"
+
+Texture2D<float4> AOHistoryIn          : register(t21);
+Texture2D<float2> EngineMotionVectors  : register(t22);
+
+#ifndef RAY_FLAGS
+#   define RAY_FLAGS (RAY_FLAG_SKIP_PROCEDURAL_PRIMITIVES | RAY_FLAG_CULL_BACK_FACING_TRIANGLES)
+#endif
+#ifndef INSTANCE_MASK
+#   define INSTANCE_MASK (0xFF)
+#endif
+
+static const uint  kRaysPerPixel   = 2;
+static const float kRadius         = 80.0f;    // game units (~1.1 m)
+static const float kMaxHistory     = 24.0f;
+static const float kDepthTolerance = 0.04f;    // relative view-depth mismatch for reuse
+
+float TraceVisibility(float3 origin, float3 direction, float tmax, inout uint randomSeed)
+{
+    RayDesc ray;
+    ray.Origin = origin;
+    ray.Direction = direction;
+    ray.TMin = 0.0f;
+    ray.TMax = tmax;
+
+    float3 transmission = float3(1.0f, 1.0f, 1.0f);
+
+    RayQuery<RAY_FLAGS | RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH> rayQuery;
+    rayQuery.TraceRayInline(Scene, RAY_FLAG_NONE, INSTANCE_MASK, ray);
+
+    while (rayQuery.Proceed())
+    {
+        if (rayQuery.CandidateType() == CANDIDATE_NON_OPAQUE_TRIANGLE)
+        {
+            if (ConsiderTransparentMaterialShadow(
+                rayQuery.CandidateInstanceID(),
+                rayQuery.CandidateGeometryIndex(),
+                rayQuery.CandidatePrimitiveIndex(),
+                rayQuery.CandidateTriangleBarycentrics(),
+                randomSeed,
+                direction,
+                rayQuery.CandidateTriangleRayT(),
+                transmission))
+            {
+                rayQuery.CommitNonOpaqueTriangleHit();
+            }
+        }
+    }
+
+    if (rayQuery.CommittedStatus() == COMMITTED_TRIANGLE_HIT)
+        return 0.0f;
+
+    return saturate(dot(transmission, float3(1.0f / 3.0f, 1.0f / 3.0f, 1.0f / 3.0f)));
+}
+
+[numthreads(8, 8, 1)]
+void Main(uint2 idx : SV_DispatchThreadID)
+{
+    const uint2 size = Camera.RenderSize;
+    if (any(idx >= size))
+        return;
+
+    const float depth = Depth.Load(int3(idx, 0));
+    const float depthVS = ScreenToViewDepth(depth, Camera.CameraData);
+
+    [branch]
+    if (depthVS < FP_VIEW_Z || depth >= SKY_Z)
+    {
+        Output[idx] = float4(1.0f, 0.0f, 0.0f, 1.0f);
+        return;
+    }
+
+    const float2 uv = float2(idx + 0.5f) / float2(size);
+    const float3 positionVS = ScreenToViewPosition(uv, depthVS, Camera.NDCToView);
+    const float3 positionCS = ViewToWorldPosition(positionVS, Camera.ViewInverse);
+    const float3 positionWS = positionCS + Camera.Position.xyz;
+
+    float3 normalWS = NormalRoughness.Load(int3(idx, 0)).xyz;
+    normalWS = dot(normalWS, normalWS) > 1e-6f ? normalize(normalWS) : float3(0.0f, 0.0f, 1.0f);
+
+    float3 faceNormal = FaceNormals.Load(int3(idx, 0)) * 2.0f - 1.0f;
+    faceNormal = dot(faceNormal, faceNormal) > 1e-6f ? normalize(faceNormal) : normalWS;
+
+    // Keep the shading normal in the visible hemisphere of the geometric face.
+    if (dot(normalWS, faceNormal) < 0.0f)
+        normalWS = normalize(normalWS - 2.0f * dot(normalWS, faceNormal) * faceNormal);
+
+    // Reconstructed depth is imprecise: offset along the face normal, growing with distance.
+    const float bias = 0.75f + depthVS * 0.0015f;
+    const float3 origin = positionWS + faceNormal * bias;
+
+    uint randomSeed = InitRandomSeed(idx, size, Camera.FrameIndex);
+
+    float visibility = 0.0f;
+    [unroll]
+    for (uint i = 0; i < kRaysPerPixel; i++)
+    {
+        float3 direction = TangentToWorld(normalWS, SampleCosineHemisphere(randomSeed));
+        // Rays grazing below the geometric face would hit the surface itself.
+        if (dot(direction, faceNormal) < 0.05f)
+            direction = normalize(direction + faceNormal * (0.05f - dot(direction, faceNormal)));
+        visibility += TraceVisibility(origin, direction, kRadius, randomSeed);
+    }
+    float ao = visibility / kRaysPerPixel;
+
+    // Temporal accumulation with depth-checked reprojection.
+    const float2 motion = EngineMotionVectors.Load(int3(idx, 0));
+    const float2 prevPixel = float2(idx) + 0.5f + motion * float2(size);
+    float history = 0.0f;
+    float historyAO = 0.0f;
+
+    if (all(prevPixel >= 0.0f) && all(prevPixel < float2(size)))
+    {
+        const float4 prevClip = mul(Camera.PrevViewProj, float4(positionWS - Camera.PositionPrev, 1.0f));
+        const float expectedDepth = prevClip.w;
+        const float4 prev = AOHistoryIn.Load(int3(int2(prevPixel), 0));
+        if (prev.y > 0.0f && abs(prev.y - expectedDepth) <= kDepthTolerance * max(expectedDepth, 1.0f))
+        {
+            history = prev.z;
+            historyAO = prev.x;
+        }
+    }
+
+    history = min(history + 1.0f, kMaxHistory);
+    ao = lerp(historyAO, ao, 1.0f / history);
+
+    Output[idx] = float4(ao, depthVS, history, 1.0f);
+}
