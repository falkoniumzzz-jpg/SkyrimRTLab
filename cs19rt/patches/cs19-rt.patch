+#ifndef CLOUD_RELIGHT_DRAINE_HLSLI
+#define CLOUD_RELIGHT_DRAINE_HLSLI
+
+/*
+ * SPDX-FileCopyrightText: Copyright (c) <2023> NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+ * SPDX-License-Identifier: MIT
