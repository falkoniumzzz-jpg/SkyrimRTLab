+	bool enableFoliageAmbientBoost = settings.EnableFoliageAmbientBoost != 0;
+	if (ImGui::Checkbox(T(TKEY("enable_foliage_ambient_boost"), "Tree Ambient Boost"), &enableFoliageAmbientBoost)) {
