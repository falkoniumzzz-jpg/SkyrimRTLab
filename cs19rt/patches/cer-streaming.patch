+
+void SceneGraph::RTLabOnMeshDestroyed(BaseMesh* mesh)
+{
+	std::scoped_lock lock(m_RTLabStaleMutex);
+	const auto [first, last] = m_RTLabStaleRefs.equal_range(mesh);
+	for (auto it = first; it != last; ++it)
+		it->second->m_RTLabForceBuild = true;
+}
+
+void SceneGraph::RTLabForgetCluster(BLASCluster* cluster)
+{
+	std::scoped_lock lock(m_RTLabStaleMutex);
+	for (auto* mesh : cluster->m_RTLabStaleMembers) {
+		const auto [first, last] = m_RTLabStaleRefs.equal_range(mesh);
+		for (auto it = first; it != last;) {
+			if (it->second == cluster)
+				it = m_RTLabStaleRefs.erase(it);
+			else
+				++it;
+		}
+	}
+	cluster->m_RTLabStaleMembers.clear();
+	cluster->m_RTLabForceBuild = false;
+	cluster->m_RTLabDeferredFrames = 0;
+	cluster->m_RTLabBuildDeferred = false;
+}
+
+void SceneGraph::RTLabSelectClusterBuilds()
+{
+	m_FrameStats.deferredClusters = 0;
+
+	// Nothing of the world is shown behind a loading screen, so the whole backlog is built there.
+	const bool noBudget = !Scene::GetSingleton()->GetMenuState().none(MenuState::LoadingMenu);
+	const auto eye = Util::Adapter::GetCameraEyePosition();
+
+	std::scoped_lock lock(m_ClusterDirtyMutex);
+
+	m_RTLabBuildOrder.clear();
+	size_t mandatory = 0;
+
+	for (auto* cluster : m_DirtyClusters) {
+		cluster->m_RTLabBuildDeferred = false;
+
+		// A hidden orphan is only dropped from the TLAS; BuildUpdate does no work for it.
+		if (!cluster->m_Owner && cluster->m_DirtyFlags == DirtyFlags::Visibility)
+			continue;
+
+		// Deferring keeps the last BLAS. That is only valid while every mesh in it is alive and
+		// unchanged in shape: no destroyed members, no refits (skinning, vertices, local transforms).
+		const bool deferrable = !noBudget &&
+		                        !cluster->m_RTLabNeverDefer &&
+		                        !cluster->m_RTLabForceBuild &&
+		                        !cluster->IsPlayer() &&
+		                        !cluster->m_DirtyFlags.any(DirtyFlags::Transform, DirtyFlags::Skin, DirtyFlags::Vertex) &&
+		                        cluster->m_RTLabDeferredFrames < kRTLabMaxClusterDeferFrames;
+		if (!deferrable) {
+			++mandatory;
+			continue;
+		}
+
+		const auto& center = cluster->m_Members.empty() ? cluster->m_WorldBound.center : cluster->m_Members.front()->GetWorldBound().center;
+		const float dx = center.x - eye.x;
+		const float dy = center.y - eye.y;
+		const float dz = center.z - eye.z;
+		m_RTLabBuildOrder.emplace_back(std::bit_cast<uint32_t>(dx * dx + dy * dy + dz * dz), cluster);
+	}
+
+	const size_t allowed = std::max(kRTLabMinDeferrableBuilds, kRTLabMaxClusterBuilds > mandatory ? kRTLabMaxClusterBuilds - mandatory : size_t{ 0 });
+	if (m_RTLabBuildOrder.size() <= allowed)
+		return;
+
+	std::sort(m_RTLabBuildOrder.begin(), m_RTLabBuildOrder.end(),
+		[](const auto& a_lhs, const auto& a_rhs) { return a_lhs.first < a_rhs.first; });
+
+	for (size_t orderIndex = allowed; orderIndex < m_RTLabBuildOrder.size(); ++orderIndex) {
+		auto* cluster = m_RTLabBuildOrder[orderIndex].second;
+		cluster->m_RTLabBuildDeferred = true;
+		++cluster->m_RTLabDeferredFrames;
+	}
+	m_FrameStats.deferredClusters = static_cast<uint32_t>(m_RTLabBuildOrder.size() - allowed);
+}
