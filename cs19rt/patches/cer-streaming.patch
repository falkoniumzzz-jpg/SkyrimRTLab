+void SceneGraph::RTLabNoteRemoved(BLASCluster* cluster, BaseMesh* mesh)
+{
+	std::scoped_lock lock(m_RTLabStaleMutex);
+	m_RTLabStaleRefs.emplace(mesh, cluster);
